{
  "functions": {
    "api/index.js": {
      "includeFiles": "finget-backend/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/s/(.*)", "destination": "/api/index.js" },
    { "source": "/join/(.*)", "destination": "/api/index.js" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
